# --- Requeridas en local y en producción ---
NODE_ENV=development            # En producción: production
PORT=3000
DOMAIN=localhost

# --- Configuración de Base de Datos (Prisma) ---
# En LOCAL: Asigna tu base de datos de PostgreSQL local a AMBAS variables para evitar errores de validación de Prisma.
# En PRODUCCIÓN (Render/GitHub): 
# - DATABASE_URL debe usar la URL con el subdominio 'pooled.db.prisma.io' (Modo Pooler).
# - DIRECT_DATABASE_URL debe usar la URL con el subdominio 'db.prisma.io' (Modo Directo para migraciones).
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/NOMBRE_DB?schema=public"
DIRECT_DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/NOMBRE_DB?schema=public"

# --- Autenticación ---
JWT_SECRET=SECRETO64Bytes

# --- Formas de generar un secreto ---
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# openssl rand -hex 64

# --- Solo producción (primer deploy; en local se usan valores por defecto) ---
# SEED_ADMIN_USERNAME=ADMIN             # Debe ser en mayúsculas
# SEED_ADMIN_EMAIL=ADMIN@EXAMPLE.COM
# SEED_ADMIN_PASSWORD=123456            # Mínimo 6 caracteres
# SEED_ADMIN_FIRST_NAME=JUAN
# SEED_ADMIN_LAST_NAME=PEREZ