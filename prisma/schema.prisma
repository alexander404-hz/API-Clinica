// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Se usará para las consultas del servidor Express (Modo Pool)
  directUrl = env("DIRECT_DATABASE_URL") // Se usará solo para migraciones (Modo Directo)
}

enum Role {
  ADMIN
  PATIENT
  SYSTEM
}

model User {
  id                 Int       @id @default(autoincrement())
  firstName          String
  lastName           String
  role               Role
  username           String    @unique
  email              String    @unique
  password           String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  patientProfile            Patient?
  statusChangedAppointments Appointment[] @relation("AppointmentStatusChangedBy")
  auditLogs                 ChangesLog[]  @relation("AuditActor")
  accessLogs                ReadsLog[]    @relation("AccessActor")
}

model Patient {
  id              Int           @id
  user            User          @relation(fields: [id], references: [id])
  preferredName   String?
  insuranceNumber String        @unique
  appointments    Appointment[]
}

model TimeBlock {
  id        Int      @id @default(autoincrement())
  startTime DateTime @db.Time(0)
  endTime   DateTime @db.Time(0)
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id       Int      @id @default(autoincrement())
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  patient   Patient @relation(fields: [patientId], references: [id])
  patientId Int

  status          AppointmentStatus @default(SCHEDULED)
  statusChangedAt DateTime?         @db.Timestamptz(3)

  statusChangedBy   User? @relation("AppointmentStatusChangedBy", fields: [statusChangedById], references: [id])
  statusChangedById Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

enum ReadAction {
  READ
  LIST
  SEARCH
}

enum ChangeAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
}

model ReadsLog {
  id Int @id @default(autoincrement())

  actorId Int
  actor   User @relation("AccessActor", fields: [actorId], references: [id])

  action    ReadAction
  entity    String
  entityId  Int?
  query     Json?
  ip        String?
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action])
}

model ChangesLog {
  id Int @id @default(autoincrement())

  actorId Int?
  actor   User? @relation("AuditActor", fields: [actorId], references: [id])

  action    ChangeAction
  entity    String
  entityId  Int?
  changes   Json?
  ip        String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}
