// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PATIENT
  SYSTEM
}

model User {
  id                 Int       @id @default(autoincrement())
  firstName          String
  lastName           String
  role               Role
  username           String    @unique
  email              String    @unique
  password           String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  patientProfile            Patient?
  statusChangedAppointments Appointment[] @relation("AppointmentStatusChangedBy")
}

model Patient {
  id              Int           @id
  user            User          @relation(fields: [id], references: [id])
  preferredName   String?
  insuranceNumber String        @unique
  appointments    Appointment[]
}

model TimeBlock {
  id        Int      @id @default(autoincrement())
  startTime DateTime @db.Time(0)
  endTime   DateTime @db.Time(0)
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id       Int      @id @default(autoincrement())
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  patient   Patient @relation(fields: [patientId], references: [id])
  patientId Int

  status          AppointmentStatus @default(SCHEDULED)
  statusChangedAt DateTime?         @db.Timestamptz(3)

  statusChangedBy   User? @relation("AppointmentStatusChangedBy", fields: [statusChangedById], references: [id])
  statusChangedById Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   String?
  action    String // INSERT, UPDATE, DELETE
  entity    String // nombre de la tabla
  entityId  String?
  changes   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  actorId   String
  entity    String
  entityId  String?
  query     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
